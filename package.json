{
  "name": "cccs-portal",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vercel dev",
    "dev": "vercel dev",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:e2e": "playwright test --config=playwright.e2e.config.mjs",
    "test:e2e:guard": "node --test tests/e2e/guard.test.mjs",
    "e2e:emulators": "node scripts/e2e-emulators.mjs",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "dev:local": "node --env-file=.env.local scripts/dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vercel": "^50.0.1"
  },
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmin1234x/CCCS.git"
  },
  "keywords": [],
