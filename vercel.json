{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/main",
      "destination": "/main.html"
    },
    {
      "source": "/training",
      "destination": "/training.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/break-rewards",
      "destination": "/break-rewards.html"
    },
    {
      "source": "/shifts-admin",
      "destination": "/shifts-admin.html"
    },
    {
      "source": "/wrapped",
      "destination": "/wrapped.html"
    },
    {
      "source": "/verification",
      "destination": "/verification.html"
    },
    {
      "source": "/waste",
      "destination": "/waste.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-chat.js": {
      "maxDuration": 60,
      "includeFiles": "module-data.js"
    },
    "api/mcassist.js": {
      "maxDuration": 60,
      "includeFiles": "module-data.js"
    },
    "api/waste.js": {
      "maxDuration": 20
    }
  }
}
